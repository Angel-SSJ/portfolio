{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format:check": "biome format . && prettier --check \"**/*.astro\"",
    "format:write": "biome format --write . && prettier --write \"**/*.astro\"",
    "lint": "biome lint . && eslint \"**/*.astro\"",
    "check:commits": "node scripts/check-commits.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:check": "node scripts/check-hooks.mjs",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@starwind-ui/astro": "1.5.0",
    "@tabler/icons": "3.52.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwind-merge": "3.7.1",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
