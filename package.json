{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format:check": "biome format . && prettier --check \"**/*.astro\"",
    "format:write": "biome format --write . && prettier --write \"**/*.astro\"",
    "lint": "biome lint . && eslint \"**/*.astro\"",
    "test:unit": "vitest run",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
